# 跨平台换行符规范
# 所有文本文件统一使用 LF 换行（仓库内存储为 LF，checkout 时不转换）
* text=auto eol=lf

# PowerShell 脚本使用 LF（PowerShell 7 跨平台兼容）
*.ps1 text eol=lf

# Bash 脚本必须使用 LF
*.sh text eol=lf

# Python 脚本使用 LF（PEP 8 规范）
*.py text eol=lf

# Markdown / JSON / JS / CSS 使用 LF
*.md text eol=lf
*.json text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf

# Windows 批处理脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.docx binary
*.zip binary
*.gz binary
